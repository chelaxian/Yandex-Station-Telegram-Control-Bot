include CHANGELOG.md NOTICE.md README.md requirements.lock.txt config.example.toml Dockerfile
include install.cmd install.ps1 install.sh
recursive-include docs *.md
recursive-include docs/assets *.png
recursive-include deploy *.py *.service
recursive-include scripts *.py
recursive-include tests *.py
prune legacy
global-exclude *.pyc __pycache__
